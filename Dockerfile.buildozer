FROM python:3.12-slim

# Install system dependencies required by Buildozer
RUN apt-get update && apt-get install -y \
    build-essential \
    git \
    zip \
    unzip \
    openjdk-17-jdk \
    autoconf \
    libtool \
    pkg-config \
    zlib1g-dev \
    libncurses5-dev \
    libncursesw5-dev \
    libtinfo5 \
    cmake \
    libffi-dev \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Buildozer and Cython
RUN pip install --upgrade pip
RUN pip install buildozer==1.5.0 cython==0.29.36