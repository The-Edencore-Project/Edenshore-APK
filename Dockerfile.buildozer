FROM python:3.11-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    git \
    zip \
    unzip \
    openjdk-17-jdk \
    autoconf \
    automake \
    libtool \
    pkg-config \
    build-essential \
    ccache \
    libffi-dev \
    libssl-dev \
    zlib1g-dev \
    sudo \
    && rm -rf /var/lib/apt/lists/*

RUN python -m pip install --no-cache-dir --force-reinstall pip==23.2.1

RUN pip install --no-cache-dir \
    cython==0.29.36 \
    buildozer==1.5.0

WORKDIR /home/user/hostcwd

CMD ["buildozer", "android", "debug"]
